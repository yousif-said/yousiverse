# Copy to .env (repo root). Every package and script reads this one file.

# Postgres. Matches docker-compose.yml.
DATABASE_URL=postgres://yousiverse:yousiverse@localhost:5432/yousiverse

# Direct (non-pooled) connection used for migrations. Set automatically by
# Neon's Vercel integration; leave unset locally.
# DATABASE_URL_UNPOOLED=

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
# Public origin of the app. Optional on Vercel previews (falls back to VERCEL_URL).
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional). Set both or neither.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple sign-in (optional). Set both or neither.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/apple
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# TMDB (movies and TV). Create a key at https://www.themoviedb.org/settings/api.
# Either the "API Key" or the "API Read Access Token" works.
TMDB_API_TOKEN=replace-with-tmdb-credential

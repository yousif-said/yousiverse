# Copy to .env (repo root). Every package and script reads this one file.

# Postgres. Matches docker-compose.yml.
DATABASE_URL=postgres://yousiverse:yousiverse@localhost:5432/yousiverse

# Direct (non-pooled) connection used for migrations. Set automatically by
# Neon's Vercel integration; leave unset locally.
# DATABASE_URL_UNPOOLED=

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
# Public origin of the app. Optional on Vercel previews (falls back to VERCEL_URL).
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional). Set both or neither.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# TMDB (movies and TV). Create a key at https://www.themoviedb.org/settings/api.
# Either the "API Key" or the "API Read Access Token" works.
TMDB_API_TOKEN=replace-with-tmdb-credential

# IGDB (games). Register an app at https://dev.twitch.tv/console; IGDB uses its Twitch credentials.
IGDB_CLIENT_ID=replace-with-twitch-client-id
IGDB_CLIENT_SECRET=replace-with-twitch-client-secret

# Watchmode (where to watch movies and TV, with rent/buy prices). Request a key at https://api.watchmode.com.
WATCHMODE_API_KEY=replace-with-watchmode-key

# IsThereAnyDeal (PC game prices). Register an app at https://isthereanydeal.com/apps/my/.
ITAD_API_KEY=replace-with-isthereanydeal-key

# Steam (importing a person's game library). Get a key at https://steamcommunity.com/dev/apikey.
STEAM_API_KEY=replace-with-steam-web-api-key

# Trakt (importing a person's watch history). Create an app at https://trakt.tv/oauth/applications.
# Only the Client ID is used: imports read public profiles, so nobody signs in to Trakt.
TRAKT_CLIENT_ID=replace-with-trakt-client-id

# Resend (sign-in links and alerts by email). Create a key at https://resend.com/api-keys with
# "Sending access", and verify the domain EMAIL_FROM sends from. Outside production no email is
# sent: sign-in links are printed in the terminal instead.
RESEND_API_KEY=replace-with-resend-key
EMAIL_FROM="Yousiverse <notifications@example.com>"

# Who may review franchise links at /admin/links: their sign-in emails, separated by commas.
# Optional; nobody can review when it is unset.
# ADMIN_EMAILS=you@example.com

# Inngest (background jobs, such as the daily alert check). Leave unset locally: outside
# production the app talks to the Inngest dev server on this machine, which needs no keys.
# On Vercel, Inngest's integration sets both.
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

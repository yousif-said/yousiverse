{
  "name": "@yousiverse/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./env": "./src/env.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio",
    "db:seed": "bun --env-file=../../.env run src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@yousiverse/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}

{
  "name": "yousiverse",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:seed": "bun run --cwd packages/db db:seed",
    "db:studio": "bun run --cwd packages/db db:studio",
    "vercel-build": "bun run db:migrate && turbo run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "turbo": "^2.11.13"
  }
}
